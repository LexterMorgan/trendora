# Trendora backend API base URL.

# Used by the Next.js server proxy (web/app/api/research/route.ts) to forward
# research requests to the Trendora FastAPI backend.
#
# Local example:
TRENDORA_API_BASE_URL=http://127.0.0.1:8000

# Never commit real credentials. Copy this file to `.env.local` and adjust.

# Public Supabase values used by the browser auth client.
# Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
