# Trendora environment template
# Copy to .env and fill in locally. Never commit real secrets.

# --- App ---
APP_ENV=development
APP_NAME=trendora
LOG_LEVEL=INFO

# --- Database (SQLAlchemy + Alembic) ---
# V1 development database: Supabase PostgreSQL
# (project https://ymzloduyggkcmapmiics.supabase.co, database name: postgres)
#
# Copy the URI from Supabase → Project Settings → Database.
# Use the SQLAlchemy psycopg (v3) driver prefix and require TLS:
#   postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
#
# Do not commit the real password. Local PostgreSQL remains supported by the
# same SQLAlchemy models if you point this URL at localhost later.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# --- Supabase auth (Gate A) ---
# Project URL (not the DB URI): https://<project-ref>.supabase.co
# Required in production (APP_ENV=production refuses to start without it);
# blank locally disables auth-unavailable paths behind 503 auth_unavailable.
SUPABASE_URL=

# --- YouTube connector (Milestone 2A) ---
# API key from Google Cloud Console → YouTube Data API v3. Never commit the real key.
YOUTUBE_API_KEY=
# Comma-separated 24-character channel IDs (UC…). Handles and URLs are rejected.
YOUTUBE_CHANNEL_IDS=
# Safety cap so a manual run cannot pull an entire channel history. Default: 50.
YOUTUBE_MAX_VIDEOS_PER_CHANNEL=50

# --- Meta / Facebook connector (M25A–M25D) ---
# Optional until enabled. Both are required to create the Facebook client;
# partial/missing settings keep the source unconfigured (503). Never commit
# the real token.
META_ACCESS_TOKEN=
# Graph API version, e.g. v19.0. Must look like v<major>.<minor>.
META_GRAPH_API_VERSION=

# --- Stack Exchange connector (Milestone 3B) ---
# Optional. Public /questions reads work without a key. Never commit a real key.
STACKEXCHANGE_API_KEY=

# --- GitHub connector (Milestone 4) ---
# Optional token. Public repository reads work without it. Never commit a real token.
GITHUB_TOKEN=
# Comma-separated owner/repository identifiers. URLs, handles, and search queries are rejected.
GITHUB_REPOSITORIES=

# --- Grounded AI interpretation provider (M20) ---
# Optional until enabled. Endpoint URL is the COMPLETE Chat Completions endpoint
# (nothing is appended). Never commit a real API key.
TRENDORA_AI_PROVIDER=example-provider
TRENDORA_AI_MODEL=example-model
TRENDORA_AI_ENDPOINT_URL=https://provider.example/v1/chat/completions
TRENDORA_AI_API_KEY=replace-me
# Optional shared AI-phase deadline in seconds (default 30). One monotonic
# deadline governs the remaining in-flight HTTP request budget across the
# interpretation request, its retry, and the optional content stages. In-flight
# I/O is cancellable at the deadline; JSON parsing, grounding validation, and
# cleanup are not strictly interrupted. An exhausted deadline skips the retry
# and optional stages and falls back to labeled source excerpts.
TRENDORA_AI_TIMEOUT_SECONDS=30

# --- Public web search provider (M36A) ---
# Optional. Enables the "public_web" research source. Two backends are
# supported; pick one explicitly or let "auto" prefer the free local one.
#
# Backend selection: auto | serper | searxng | none  (default: auto)
#   auto    -> prefer self-hosted SearXNG when SEARXNG_URL is set, else Serper
#   serper  -> Serper only (paid; requires SERPER_API_KEY)
#   searxng -> self-hosted SearXNG only (free; requires SEARXNG_URL)
#   none    -> disable public web
# A named backend never silently falls back to a different (paid) provider.
TRENDORA_WEB_SEARCH_BACKEND=auto
# Toggle the public_web source on/off. Default: true.
TRENDORA_WEB_SEARCH_ENABLED=true
# Self-hosted SearXNG base URL (free local discovery). See deploy/searxng/.
# Example: SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_URL=
# Serper.dev key. Never commit the real key. Free-tier accounts have a limited
# monthly request quota.
SERPER_API_KEY=

# --- Future milestones ---
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_ACCESS_TOKEN=
# AI_PROVIDER=
# AI_API_KEY=
# AI_BASE_URL=
