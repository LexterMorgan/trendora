# Trendora environment template
# Copy to .env and fill in locally. Never commit real secrets.

# --- App ---
APP_ENV=development
APP_NAME=trendora
LOG_LEVEL=INFO

# --- Database (SQLAlchemy + Alembic) ---
# V1 development database: Supabase PostgreSQL
# (project https://ymzloduyggkcmapmiics.supabase.co, database name: postgres)
#
# Copy the URI from Supabase → Project Settings → Database.
# Use the SQLAlchemy psycopg (v3) driver prefix and require TLS:
#   postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
#
# Do not commit the real password. Local PostgreSQL remains supported by the
# same SQLAlchemy models if you point this URL at localhost later.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# --- YouTube connector (Milestone 2A) ---
# API key from Google Cloud Console → YouTube Data API v3. Never commit the real key.
YOUTUBE_API_KEY=
# Comma-separated 24-character channel IDs (UC…). Handles and URLs are rejected.
YOUTUBE_CHANNEL_IDS=
# Safety cap so a manual run cannot pull an entire channel history. Default: 50.
YOUTUBE_MAX_VIDEOS_PER_CHANNEL=50

# --- Meta / Facebook connector (M25A–M25D) ---
# Optional until enabled. Both are required to create the Facebook client;
# partial/missing settings keep the source unconfigured (503). Never commit
# the real token.
META_ACCESS_TOKEN=
# Graph API version, e.g. v19.0. Must look like v<major>.<minor>.
META_GRAPH_API_VERSION=

# --- Stack Exchange connector (Milestone 3B) ---
# Optional. Public /questions reads work without a key. Never commit a real key.
STACKEXCHANGE_API_KEY=

# --- GitHub connector (Milestone 4) ---
# Optional token. Public repository reads work without it. Never commit a real token.
GITHUB_TOKEN=
# Comma-separated owner/repository identifiers. URLs, handles, and search queries are rejected.
GITHUB_REPOSITORIES=

# --- Grounded AI interpretation provider (M20) ---
# Optional until enabled. Endpoint URL is the COMPLETE Chat Completions endpoint
# (nothing is appended). Never commit a real API key.
TRENDORA_AI_PROVIDER=example-provider
TRENDORA_AI_MODEL=example-model
TRENDORA_AI_ENDPOINT_URL=https://provider.example/v1/chat/completions
TRENDORA_AI_API_KEY=replace-me

# --- Future milestones ---
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_ACCESS_TOKEN=
# AI_PROVIDER=
# AI_API_KEY=
# AI_BASE_URL=
