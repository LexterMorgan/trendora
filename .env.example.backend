# Trendora Backend API Configuration (reference template)
# Copy to `.env` and fill in. Never commit real secrets.
# Full guide: docs/DEPLOYMENT.md

# --- App ---
APP_ENV=development
APP_NAME=trendora
LOG_LEVEL=INFO

# --- Database (SQLAlchemy + Alembic) ---
# Supabase PostgreSQL. Use the psycopg (v3) driver prefix and require TLS.
# postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# --- YouTube Data API v3 (required for YouTube research) ---
# From Google Cloud Console. Never commit the real key.
YOUTUBE_API_KEY=

# --- Meta / Facebook public Page research (optional) ---
# Both required to enable Facebook; missing settings leave it unconfigured (503).
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=

# --- Grounded AI provider (required for the report pipeline) ---
# Endpoint URL is the COMPLETE Chat Completions endpoint. Never commit a key.
TRENDORA_AI_PROVIDER=openrouter
TRENDORA_AI_MODEL=z-ai/glm-5.3
TRENDORA_AI_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions
TRENDORA_AI_API_KEY=

# --- Frontend proxy target (backend does not read this; documented for parity) ---
# Set on the frontend host instead: see .env.example.frontend
