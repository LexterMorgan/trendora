# Trendora Frontend Configuration (reference template)
# Copy to `.env.local` in web/ and fill in. Never commit real secrets.
# Full guide: docs/DEPLOYMENT.md

# Base URL of the deployed FastAPI backend. The Next.js API routes proxy
# same-origin `/api/*` requests to this URL. Use http://localhost:8000 for
# local development.
TRENDORA_API_BASE_URL=http://localhost:8000
